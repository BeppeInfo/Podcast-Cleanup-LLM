# Podcast-Cleanup-LLM — every setting, for the container.
#
# Copy to podcast-cleanup.env and edit. That file is gitignored (*.env); this
# one is tracked, so keep endpoints and keys out of it.
#
#   docker run --rm --network host \
#       -v ./data:/data -v ./models:/models \
#       --env-file podcast-cleanup.env \
#       ancapepe/podcast-cleanup:latest cli --keep-work
#
# **Docker env-file format, not shell.** Values run to the end of the line and
# are taken literally — no quoting, no expansion, and a pair of quotes would
# become part of the value. That matters most for WHISPER_PROMPT below, which
# contains spaces, commas, apostrophes and an em dash, all fine unquoted.
# podcast-cleanup.conf.example is the bash-syntax equivalent for a checkout, and
# carries the long-form reasoning behind most of these.
#
# Every setting is listed with the value the working configuration uses. Where
# that differs from the built-in default, the default is named in the comment
# beside it. A commented-out line means "unset", which is not the same as an
# empty value here: `NAME=` sets the variable to the empty string and overrides
# the default, so blanking a setting with a non-empty default blanks it for real.

# --- filesystem -----------------------------------------------------------------
# The image sets PODCAST_ROOT=/data and the entrypoint creates the four
# directories under it, so leave these unset unless the layout genuinely moves.
# Each is derived from the root when unset: incoming, output, work, failed.
#PODCAST_ROOT=/data
#INPUT_DIR=/data/incoming
#OUTPUT_DIR=/data/output
#WORK_ROOT=/data/work
#FAILED_DIR=/data/failed

# Input tracks are <episode><SEP><participant>.<ext>: ep042_leonardo.flac is
# episode "ep042", participant "leonardo".
TRACK_SEPARATOR=_

# Narrowed to the one format actually recorded here, so nothing else in the
# incoming directory gets swept up. The same participant present in two formats
# is an error, not a preference.
# default: flac wav wave aiff aif m4a mp4 mka mkv mp3 ogg oga opus wv ape alac
INPUT_EXTS=flac

# Deprecated name for INPUT_EXTS; still works, but it only filters inputs — the
# output format is set under rendering. validate() folds it in.
#TRACK_EXT=

# --- transcription --------------------------------------------------------------
# large-v3, not the default small and not turbo. What this pipeline needs from a
# transcript is the disfluencies, and a model's fluency works against that —
# small found no fillers at all on the sample, and what it smooths away nothing
# downstream can cut. Measured 2026-08-09 on the 57s sample: turbo lands 3.50s
# from the hand edit where large-v3 lands 1.14s.
# default: small
WHISPER_MODEL=large-v3

# cpu, or cuda with an NVIDIA card. No ROCm path — faster-whisper is built on
# CTranslate2, which has no AMD backend, so a Radeon means cpu.
WHISPER_DEVICE=cpu

# int8 on a CPU. float16 needs cuda and is ignored without it; float32 is slower
# for no gain here. Choices: int8, float16, float32.
WHISPER_COMPUTE_TYPE=int8

# How many VAD segments are decoded at once. Trades memory for speed.
WHISPER_BATCH_SIZE=8

# 4 buys roughly 2x over 1 without touching the transcript — seven runs at four
# threads on the sample came back byte-identical.
#
# The config default carries an older warning: CTranslate2 reduces across threads
# in whatever order they finish, and three runs at 4 threads once gave 70, 62 and
# 69 words, the differences being exactly the fillers and repetitions. That fault
# no longer reproduces and nobody knows why. Treat it as an unexplained absence
# rather than a fix: drop to 1 for any A/B you intend to believe, and before
# trusting the eval harness in tools/.
WHISPER_THREADS=4

# A language code is both faster and more accurate than detection on a two-hour
# recording. "auto" to detect.
# default: auto
WHISPER_LANG=en

# The one detector that decides where speech is. The silence stage runs it once,
# before transcription, and publishes the episode cut on its silence alone as
# <participant>_silence; the full edit starts from the same map and lets the
# words shorten it, never lengthen it. WhisperX's own VAD uses it too.
# pyannote is WhisperX's own default and ships its weights inside the package;
# silero is what whisper-server ran, which makes it the like-for-like setting
# against results from that era, and it fetches from torch.hub on first use. Set
# explicitly because saying nothing looks like a choice and is not one.
# Choices: pyannote, silero.
WHISPER_VAD_METHOD=pyannote

# The probabilities at which speech is declared to start and to stop. This
# decides what the silence cut keeps and what Whisper transcribes at all, and
# therefore what exists downstream to be protected. Raise the onset if a transcript comes back looping, which is
# what Whisper does when handed something that is not speech; lower it if quiet
# speech is going missing.
WHISPER_VAD_ONSET=0.500
# pyannote only. Silero reads the onset and the chunk size and ignores this.
WHISPER_VAD_OFFSET=0.363

# Whisper re-decodes at a rising temperature when a pass trips its
# compression-ratio or log-probability threshold. Repeated words compress well,
# so a genuine stutter is exactly what trips it and the retry decodes it away.
# Off, therefore. Turn it on only for a track with a real repetition loop, which
# the plan stage reports under looping_transcripts.
WHISPER_TEMPERATURE_FALLBACK=0

# Bound each word's span by the level scan when building the speech map. Whisper
# word timings run past the audio as a matter of course — one arrived spanning
# nineteen seconds — and a map built from those reads as wall-to-wall speech, so
# no gap ever qualifies as silence. Trims, never extends.
SPEECH_MAP_CLIP=1

# Conditioning text, not an instruction: seeded into the decoder as though it
# were the transcript preceding the audio. Nothing in it is obeyed, so wording it
# as a request achieves nothing — the fillers themselves do the work. Left empty,
# Whisper returns fluent prose and drops the disfluencies this pipeline exists to
# cut; of six removed by hand on a sample, an empty prompt left five absent from
# the transcript entirely. Unquoted on purpose — see the header.
# default: (empty)
WHISPER_PROMPT=Um, uh, so, like, you know, I mean — um, that's, that's the thing.

# --- detection ------------------------------------------------------------------
# Where edit detection is sent. Required unless LLM_ENABLE=0. Point this at your
# own llama-server; --network host is why a hostname on the LAN works.
# default: (empty)
LLAMA_ENDPOINT=http://127.0.0.1:8080

# Matches llama-server's own --api-key. Prefer the _FILE form: this file is a
# poor place for a secret, and the run log is copied into the output directory
# and outlives the work directory, the inputs and the container. The key is never
# written to it by value either way.
LLAMA_API_KEY=
#LLAMA_API_KEY_FILE=/etc/podcast-cleanup/llama.key

LLAMA_REQUEST_TIMEOUT=600

# chat = /v1/chat/completions, where the server applies the loaded model's own
# template, so the model can be swapped without anything here knowing which it
# is. completion = /completion, a raw prompt with no template. Choices: chat,
# completion.
LLM_API=chat

# The model id to name in each request. A server hosting one model ignores it; a
# router hosts several and refuses anything that does not name one. A router also
# has to have it loaded — with --no-models-autoload, naming an unloaded model
# gives "model is not loaded". List what a server offers with:
#   curl -s http://your-server:8080/v1/models | python3 -m json.tool
# default: (empty)
LLAMA_MODEL_NAME=gemma-general

# Ceiling on a single reply. A 350-word window rarely yields more than a handful
# of edits; raise it only if replies are being cut off mid-JSON, which the audit
# log shows as raw unparseable text.
LLM_MAX_REPLY_TOKENS=2048

# Context per slot, for a server that will not report it. At 0 it is asked
# directly: /slots gives n_ctx already divided among the slots, which is both
# more accurate and impossible to leave stale. Only for a build started with
# --no-slots. Setting it when the server does answer is not an override — the
# smaller of the two wins and a disagreement is reported rather than obeyed.
LLAMA_CTX=0

# Before the first track, send one tiny request and check the reply really is
# schema-constrained JSON. A server that answers /health but ignores
# response_format would otherwise be found only after every chunk of every track
# had been dropped as unparseable — an episode reporting no edits at all, which
# is indistinguishable from clean speech. Costs one request.
LLM_CHECK_SCHEMA=1

# How many transcript windows are in flight. Windows are independent, so this is
# pure throughput: at 1 the server decodes at batch size 1 and cannot use the
# cores. It is a ceiling, not a claim — the detect stage caps it at the server's
# slot count and says so. Raise the server's -c by the same factor, since the
# slots divide it unless it was started with --kv-unified.
LLM_CONCURRENCY=1

# --- editing --------------------------------------------------------------------
# Where a long track may be split into chunks. Nothing here decides what is cut,
# only where a boundary lands, so it has to find *a* quiet spot rather than judge
# one. The threshold errs low on purpose: too high and a split lands in quiet
# speech; too low and it falls at the nominal position instead.
SPLIT_SILENCE_THRESHOLD=-45dB
SPLIT_MIN_SILENCE=0.30

# Every word is widened by this before the union that makes the speech map, so a
# gap must clear SILENCE_MIN_DURATION plus twice this before anything is removed.
# Raise for rarer, safer cuts; lower for tighter ones.
# 0.35 and 0.10 came from tools/sweep_params.py against this episode: F1 63.9%
# against 60.1% at the previous 0.5 / 0.25. One fixture, so treat as provisional.
# default: 0.25
SPEECH_PAD=0.15
# default: 1.5
SILENCE_MIN_DURATION=0.35

# Silence kept at the very start and end of the episode.
# default: 0.25
EDGE_KEEP=0.10

# Speech margin either side of every cut, guarding a word boundary that would
# otherwise clip a consonant. Lowered from 0.10 to leave more of the natural
# pause at each disfluency cut: the residual gap grows by up to twice the
# reduction, capped at half the real gap to the neighbouring word.
# default: 0.10
CUT_PADDING=0.05

# A gap longer than SILENCE_MIN_DURATION is shortened to this, not removed.
#
# **SILENCE_KEEP and CUT_PADDING are one setting, not two.** Each end of a
# shortened gap keeps max(SILENCE_KEEP/2, CUT_PADDING), so any SILENCE_KEEP at or
# below twice CUT_PADDING does nothing at all — silently. The run warns when they
# are set that way. 0.20 against CUT_PADDING=0.05 gives a 0.10 margin, the same
# one CUT_PADDING=0.10 used to force, so silence cuts are unchanged from the run
# this file reproduces; verified by planning the sample fixture both ways.
# default: 0.40
SILENCE_KEEP=0.20

# Splices shorter than this are not worth making. Gates silence cuts only.
MIN_CUT=0.15

# Fade at each end of a per-track mute, to avoid a click. plan.py fuses mutes
# closer together than twice this, which also silences the audio between them.
# default: 0.030
MUTE_FADE=0.05

# Ramp down into every cut and back up out of it, so a splice is a fade rather
# than a step. Applied before the cut is taken, on the original timeline, so the
# ramp lands on the audio either side of the join and the flat middle is
# discarded with the cut: it costs no time and changes no duration.
#
# `volume` is re-evaluated once per RENDER_FRAME_SAMPLES, so the ramp is a
# staircase — at 512 samples and 48 kHz each step is ~10.7 ms, and anything
# shorter than a few frames is just a smaller step. Keep it at 0.03 or above, or
# lower RENDER_FRAME_SAMPLES to buy resolution.
#
# One practical consequence: a faded render cannot be scored by tools/. That
# harness recovers the cut list by correlating the render against the original,
# and ramping every join throws the alignment off. Measure with CUT_FADE=0 and
# fade only what you ship — the fade moves no boundary and changes no duration,
# so the two runs differ in nothing the score could see.
# default: 0
CUT_FADE=0.05

# --- stop after -----------------------------------------------------------------
# How far the edit goes, each step published beside the ones before it:
# silence (<participant>_silence, no transcription), transcript
# (<participant>_transcript, the words' silence too, no llama endpoint), or full
# (<participant>, plus the LLM's disfluency edits).
# Choices: silence, transcript, full. default: full
STOP_AFTER=full

# --- edit detection -------------------------------------------------------------
LLM_ENABLE=1

# Transcripts go as indexed words in overlapping windows. The model replies with
# word-index ranges, never timestamps, and the indices are validated against the
# transcript already held — so it cannot invent a position in the audio.
LLM_CHUNK_WORDS=350
LLM_CHUNK_OVERLAP=40

# Sanity bounds on a single edit. Anything larger is rejected as a
# misunderstanding rather than trusted, with the reason recorded in the audit log.
LLM_MAX_EDIT_WORDS=12
LLM_MAX_EDIT_SECONDS=4.0

LLM_MIN_CONFIDENCE=0.6
LLM_TEMP=0

# Available kinds: stutter, repetition, false_start, filler. "filler" is off by
# default because removing every one tends to read as over-editing; it is on here
# deliberately. It covers the non-lexical hesitation sounds ("um", "uh", "er")
# and nothing else — crutches built from real words ("well…", "you know", "né")
# are detected by no kind. DESIGN.md §6 explains what taking them on would cost.
# default: stutter,repetition,false_start
LLM_ACCEPT_KINDS=stutter,repetition,false_start,filler

# A plan removing more than this fraction of the episode is refused — that almost
# always means a threshold is wrong, not that the episode is half silence.
# --force overrides.
MAX_CUT_FRACTION=0.5

# --- rendering ------------------------------------------------------------------
# Output format, independent of what came in. FLAC because these tracks go on to
# be mixed, so losing nothing matters more than size. The encoder is checked at
# startup, so a codec this ffmpeg lacks fails immediately rather than after
# transcribing two hours of audio.
OUTPUT_CODEC=flac
OUTPUT_EXT=flac
OUTPUT_COMPRESSION=8
# e.g. -b:a 192k for a lossy codec. Unquoted, like everything here.
OUTPUT_EXTRA_ARGS=
# Appended to each participant name in the output filename.
OUTPUT_SUFFIX=

# Cuts land on frame boundaries, so every track of an episode must be
# frame-aligned at the same rate, or one cut list removes slightly different
# spans from each and they drift apart over hundreds of cuts.
#
#   (empty)  a rate mismatch is an error — resample beforehand yourself
#   auto     resample everything to the highest rate present
#   48000    resample everything to this rate
#
# Off by default because resampling is a real transformation, not repackaging.
RESAMPLE_TO=

# Timing granularity of the edit: 512 samples is ~11 ms at 48 kHz. Smaller is
# more precise and fades more smoothly, but slower to render. It has to be the
# same for every track of an episode, which is why it is a config setting rather
# than a per-track choice.
RENDER_FRAME_SAMPLES=512

# How many ffmpeg jobs run at once. The default is half the detected cores.
FFMPEG_JOBS=2

# Rendered duration must land within this fraction of the frame-exact prediction
# of what the filter graph will emit, or the run fails and the inputs are kept.
DURATION_TOLERANCE=0.02

# --- housekeeping ---------------------------------------------------------------
# Both default to 0: the work directory is removed and the original inputs are
# deleted, but only after every output track has been verified. Any failure
# preserves both regardless. Kept at 1 here because the work directory is what
# tools/ scores and what a --from re-run resumes from.
#
# Note a re-run silently skips tracks whose state markers say they finished —
# clear those before an A/B, or it reports success having done nothing.
# default: 0
KEEP_WORK=1
# default: 0
KEEP_INPUTS=1

# What happens to the inputs of a failed episode: log, or move them to
# FAILED_DIR. Choices: log, move.
FAILED_ACTION=log
