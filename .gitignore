__pycache__/
*.py[cod]

# A local config is machine-specific; the example is the tracked one. The .env
# is the same thing in docker's env-file syntax, and carries endpoints and model
# names for one particular machine.
podcast-cleanup.conf
*.env

# The layout the run creates. The root defaults to the directory holding
# clean-podcast.sh, so a checkout that is used in place grows these.
/incoming/
/output/
/work/
/failed/

# Real recordings used for manual testing. Nobody consented to these being
# published, so they must never become a commit — and the checkout root is
# where they naturally land. The tracked sample under tests/samples/ is the
# only audio that belongs in git.
/*.flac
/*.wav
/*.m4a
/*.mp3

# The web app's data volume when it is run from a checkout.
/data/
