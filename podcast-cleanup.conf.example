# Podcast-Cleanup-LLM configuration.
#
# Copy to one of the locations searched at startup (first match wins):
#
#   the path given to --config
#   $PODCAST_CLEANUP_CONF
#   ./podcast-cleanup.conf
#   ${XDG_CONFIG_HOME:-~/.config}/podcast-cleanup/config
#   /etc/podcast-cleanup.conf
#
# Sourced as bash: only assignments, no logic worth speaking of. Anything left
# unset falls back to the default shown in the comment.

# ---------------------------------------------------------------- filesystem --

# Everything the run reads and writes lives under one root, created on first use.
# The default is the directory holding clean-podcast.sh, which makes a checkout
# self-contained — good for a workstation, where the models are usually remote
# anyway. --root overrides it for a single run.
#PODCAST_ROOT="/srv/media/podcast"

# Derived from the root unless set here:
#
#   INPUT_DIR    $PODCAST_ROOT/incoming    tracks waiting to be processed
#   OUTPUT_DIR   $PODCAST_ROOT/output      finished episodes, one directory each
#   WORK_ROOT    $PODCAST_ROOT/work        per-episode intermediates
#   FAILED_DIR   $PODCAST_ROOT/failed      logs (and inputs, see FAILED_ACTION)
#
# Set them individually only when they genuinely belong apart — output on a
# different volume from the scratch space, say. A setting here beats the root;
# a --root on the command line beats a setting here, since the whole point of
# asking for a root is to move the layout.
#INPUT_DIR="/srv/media/podcast/incoming"
#OUTPUT_DIR="/srv/media/podcast/output"
#WORK_ROOT="/var/tmp/podcast-work"
#FAILED_DIR="/srv/media/podcast/failed"

# Input tracks are named <episode><SEP><participant>.<ext>, e.g.
# "ep042_leonardo.flac" -> episode "ep042", participant "leonardo".
TRACK_SEPARATOR="_"

# Which extensions to look for, matched case-insensitively. Anything ffmpeg can
# decode works — the prepare stage decodes to PCM regardless, so the container is
# only a matter of finding the files. Video containers are fine too; the first
# audio stream is taken.
#
# Two tracks of one episode may be in different formats: decoders handle encoder
# delay correctly, so they stay sample-aligned. What they may *not* do is differ
# in sample rate — see RESAMPLE_TO below.
INPUT_EXTS="flac wav wave aiff aif m4a mp4 mka mkv mp3 ogg oga opus wv ape alac"

# Narrow it if the input directory holds other things you do not want swept up:
#INPUT_EXTS="flac"

# (TRACK_EXT is the old name for this and still works, but it only filters
# inputs now — the output format is set below.)

# ----------------------------------------------------------------- whisperx --

# Transcription runs in this process. There is no endpoint, no key and no
# timeout, because there is no server: WhisperX is a library, it is installed in
# the image, and the audio never leaves the machine doing the editing.
#
# What it buys over sending the audio to whisper-server is *word timings*.
# Whisper interpolates them from token positions; WhisperX aligns the transcript
# against the audio with wav2vec2 and returns a measured start and end for every
# word. Everything downstream is decided in seconds — which stretches are
# speech, where a cut may start, how long the result should be — so this is the
# number the pipeline has always actually wanted.

# Which Whisper model. tiny, base, small, medium, large-v3, or a path.
#
# On a CPU this is the setting that decides how long a run takes, and there is
# no way around it: WhisperX accelerates on CUDA only, so a machine with a
# Radeon card transcribes on its cores like any other.
#
# **Bigger is not simply better here, and smaller is not simply faster.** What
# this pipeline needs from a transcript is the disfluencies, and a model's
# fluency works against that. Measured on the 57s sample, host track, one
# thread, same prompt — fillers is "um"/"uh" surviving, repeats is a word
# immediately repeated:
#
#     model             words  fillers  repeats   transcribe
#     tiny                 77        4        7          6s
#     base                 72        4        5          6s
#     small                62        0        4         11s
#     large-v3-turbo       62        3        3         34s
#     large-v3             67        4        6         50s
#
# small found *no fillers at all* — it is fluent enough to tidy them away, and
# what it removes the detector can never cut. tiny and base keep the most but
# mishear words badly ("what it felt heist", "ROCast"). large-v3 keeps as much
# as tiny and gets the words right, at five times small's runtime; turbo sits
# between them.
#
# One 57-second clip, one track. Confirm on your own episode before trusting the
# ordering — but do check that whatever you choose still contains the fillers,
# because that is the ceiling on everything downstream.
WHISPER_MODEL="small"

# cpu, or cuda if there is an NVIDIA card. There is no ROCm path — faster-whisper
# is built on CTranslate2, which has no AMD backend, so Radeon means cpu.
WHISPER_DEVICE="cpu"

# int8 on a CPU. float16 needs cuda and is ignored without it; float32 is slower
# for no gain here.
WHISPER_COMPUTE_TYPE="int8"

# How many VAD segments are decoded at once, and how many cores to use. Batch
# size trades memory for speed.
WHISPER_BATCH_SIZE="8"

# **Only 1 is reproducible.** CTranslate2 reduces across threads in whatever
# order they finish, and that floating-point difference is enough to change
# which beam wins. Three runs of the same audio at 4 threads gave 70, 62 and 69
# words — and the words that came and went were the fillers and the repetitions,
# which is exactly what the run is looking for.
#
# Left at 4 because most runs want the speed and a shifting filler is not a
# broken episode. Set it to 1 before comparing two configurations, or the
# difference being measured is drowned by this.
WHISPER_THREADS="4"

# Whisper re-decodes at a rising temperature when a pass looks too repetitive or
# too improbable. A stutter looks exactly like that, so the retry decodes away
# what this pipeline exists to find; the old client asked whisper-server for
# temperature=0 for the same reason. Turn it on only for a track with a genuine
# repetition loop, which the plan stage reports under looping_transcripts.
WHISPER_TEMPERATURE_FALLBACK="0"

# Language code, or "auto" to detect. Setting it explicitly is both faster and
# more accurate than detection on a two-hour recording.
WHISPER_LANG="auto"
#WHISPER_LANG="pt"

# ------------------------------------------------------------ speech detection --

# WhisperX always runs a voice activity detector — it is how the audio is cut
# into batches, not an option — so unlike whisper-server there is nothing to turn
# off. What is left is which detector, and where its thresholds sit.
#
# It still does the same two jobs it always did, and they are still the reason
# this matters more than it looks. Whisper transcribes only what the VAD calls
# speech, and handed silence it invents text and loops a phrase while doing it;
# the plan then derives its speech map from the words that come back. So what is
# silence to cut, and what is speech to protect, is decided here.
#
# pyannote is WhisperX's own default and ships its weights inside the package.
# silero is what whisper-server ran, which makes it the like-for-like setting
# when comparing a run against results from that era; it fetches its model from
# torch.hub the first time it is used.
WHISPER_VAD_METHOD="pyannote"

# The probabilities at which speech is declared to start and to stop. These
# replace whisper-server's Silero threshold and its four durations in
# milliseconds, and they are not the same knobs under new names: pyannote takes
# an onset and an offset and assembles its own segments. Translating the old
# values onto these would have been a guess dressed as a setting, so the old
# names were removed rather than mapped.
#
# Raise the onset to make the detector stricter about what it calls speech —
# which is the lever when a transcript comes back looping, since that is what
# Whisper does when handed something that is not speech.
WHISPER_VAD_ONSET="0.500"

# pyannote only. Silero reads the onset and the chunk size and ignores this.
WHISPER_VAD_OFFSET="0.363"

# ------------------------------------------------------- what reaches the LLM --

# Whisper's initial prompt. This is conditioning text, not an instruction: it is
# seeded into the decoder as though it were the transcript preceding the audio,
# and the decode carries on in whatever register it was handed. Nothing in it is
# obeyed, so wording it as a request achieves nothing — the fillers themselves are
# what does the work.
#
# It matters more than it looks. Left empty, Whisper returns *fluent prose*: it
# drops the fillers, stutters and false starts this pipeline exists to cut, and
# absorbs the time they occupied into the neighbouring word. Nothing downstream
# can then find them — the LLM stage only sees the transcript, and the plan stage
# sees one long word where there was a pause, so the silence is not a gap either.
# Measured on a two-track sample: of six disfluencies removed by hand, an empty
# prompt left five of them absent from the transcript entirely.
#
# Alignment does not change this. WhisperX re-times the words Whisper chose; it
# does not choose different words, so a fluent decode stays fluent and the
# fillers stay gone. The prompt is still the only thing that keeps them.
#
# The cost is the mirror image: a decode biased towards fillers can invent one in
# silence, and since the speech map is derived from these words, an invented
# filler becomes speech in the plan. The VAD above is what leaves it no silence
# to appear in.
WHISPER_PROMPT="Um, uh, so, like, you know, I mean — um, that's, that's the thing."

# Bound each word's span by the level scan when building the speech map.
#
# Whisper's word timings run past the audio as a matter of course — a word
# routinely spans the silence between phrases, and one arrived spanning nineteen
# seconds. A map built from those spans reads as wall-to-wall speech, and then two
# things go wrong: no gap is ever long enough for SILENCE_MIN_DURATION to fire,
# and one participant's stretched word covers whatever the other says underneath
# it, so their disfluencies are muted as crosstalk instead of cut.
#
# This trims and never extends. The scan is not asked whether something is speech
# — it cannot tell speech from a cough — only when the audio actually happened. A
# track with no scan keeps its timings as they are.
#
# Forced alignment is the reason this may no longer be needed: measured timings
# should not run past the audio the way interpolated ones did. It is left on
# because "should not" is not "does not", and turning it off is a measurement
# rather than a guess — compare a run each way before deciding.
SPEECH_MAP_CLIP="1"

# ----------------------------------------------------------------- llama.cpp --

# Where edit detection is sent. Required unless LLM_ENABLE=0. As with Whisper,
# this is a server someone else runs: keeping it from competing with anything
# else for memory — including the whisper-server, if they share a machine — is
# that machine's business, not this script's.
LLAMA_ENDPOINT="http://127.0.0.1:8080"

# Matches llama-server's own --api-key. Same advice as for the Whisper key
# above: prefer the _FILE form.
LLAMA_API_KEY=""
#LLAMA_API_KEY_FILE="/etc/podcast-cleanup/llama.key"


# The server's own -c governs the context, and nothing here can check it agrees
# with LLM_CHUNK_WORDS any more. Worth sizing by hand: at LLM_CHUNK_WORDS=350 a
# request is ~3.3k prompt tokens plus whatever LLM_MAX_REPLY_TOKENS reserves, so
# a slot needs about 6k. llama-server divides -c among its --parallel slots
# unless given --kv-unified, so -c 8192 --parallel 4 leaves 2048 each and
# truncates — silently, showing up only as a track with suspiciously few edits.
# See "Running the servers" in the README.

LLAMA_REQUEST_TIMEOUT="600"

# Which llama.cpp endpoint the detection stage uses.
#
#   chat        /v1/chat/completions. The server applies the chat template of
#               whichever model it has loaded, so the model can be swapped or
#               upgraded without anything here knowing which one it is. This is
#               the reason to prefer it.
#   completion  /completion. A raw prompt with no template applied — the way
#               this used to work. Keep it for a build without the chat
#               endpoint, or to compare the two on the same episode.
LLM_API="chat"

# The model id to name in each request. A llama-server hosting one model ignores
# it, so it can stay empty; one in *router mode* hosts several and refuses any
# request that does not name one — "model name is missing from the request".
# List what a server offers with:
#
#   curl -s http://your-server:8080/v1/models | python3 -m json.tool
#
# A router also has to have the model loaded. If it was started with
# --no-models-autoload, naming an unloaded model gives "model is not loaded"
# and it must be loaded before the run.
LLAMA_MODEL_NAME=""
#LLAMA_MODEL_NAME="Qwen3.6-35B-A3B-Q4_K_M"

# Ceiling on a single reply. A 350-word chunk rarely yields more than a handful
# of edits, so this is generous; raise it only if replies are being cut off
# mid-JSON (the audit log shows the raw text of anything that failed to parse).
LLM_MAX_REPLY_TOKENS="2048"

# Before the first track, send one tiny request and check the reply really is
# schema-constrained JSON. A server that answers /health but ignores
# response_format would otherwise be discovered only after every chunk of every
# track had been dropped as unparseable — an episode reporting no edits at all,
# which is indistinguishable from clean speech. Costs one request.
LLM_CHECK_SCHEMA="1"

# How many transcript windows are sent at once. Windows are independent, so this
# is pure throughput: at 1 the server decodes at batch size 1, which is bound by
# memory bandwidth and leaves most of a CPU idle however many cores it has.
#
# It has to agree with the server's slot count, because nothing can detect a
# mismatch: too high and the surplus just queues inside the server, invisibly.
#   - a server this script starts gets --parallel from this value, unless
#     LLAMA_EXTRA_ARGS already pins one with -np
#   - with LLAMA_ENDPOINT, set this to the -np that server was launched with
#
# And raise LLAMA_CTX with it. Splitting the KV cache is the default once a slot
# count is given, so -c is shared out among the slots and each window still has
# to fit in its share. The detect stage checks and warns, but it can only do the
# arithmetic for a server it starts itself.
LLM_CONCURRENCY="1"

# ------------------------------------------------------- silence definition --

# Silence is where the transcript has no words. There is no separate detector and
# no threshold to tune: Whisper's Silero pass (above) decided what to transcribe,
# and the speech map is the padded union of the words it returned.
#
# Every word is widened by this much before that union, which prices every cut. A
# gap between words has to exceed SILENCE_MIN_DURATION *plus twice this* before it
# is silence at all, and the padding is also how much of Whisper's timing error a
# cut is not allowed to eat. Whisper's word boundaries sit within a couple of
# hundred milliseconds of the truth, and further out where a segment arrived
# without per-token timings and its words had to be spread across it evenly.
#
# Raise it for rarer, more conservative cuts; lower it for tighter, more numerous
# ones. At 0 a cut may start at the exact millisecond Whisper claims a word ended.
SPEECH_PAD="0.25"

# Where a long track may be split into upload chunks. Nothing here decides what
# is speech, so it only has to find *a* quiet spot, not judge one — the cost of
# getting it wrong is one word damaged at one boundary, not a wrong edit.
#
# The threshold errs low on purpose: too high and a split lands in quiet speech;
# too low and it simply falls at the nominal position instead. On a real recording
# here, speech ran from -21dB down to -39dB over a floor near -50dB, so -45dB
# clears the quiet end of speech.
SPLIT_SILENCE_THRESHOLD="-45dB"
SPLIT_MIN_SILENCE="0.30"

# A stretch of time counts as silence only when *no* track has speech in it.
# Gaps longer than SILENCE_MIN_DURATION are shortened to SILENCE_KEEP rather
# than removed outright, so the edit keeps its breathing room.
#
# **SILENCE_KEEP and CUT_PADDING are one setting, not two.** Half of
# SILENCE_KEEP is left at each end of a shortened gap — but never less than
# CUT_PADDING, since a cut always keeps that much margin. So any SILENCE_KEEP
# at or below twice CUT_PADDING does nothing at all, silently: with
# CUT_PADDING=0.1, the values 0.15 and 0.05 produce byte-identical plans. The
# run warns when they are set that way. It is also inert from the other
# direction, when SILENCE_MIN_DURATION is high enough that no gap qualifies in
# the first place; the two traps are independent and both are quiet.
SILENCE_MIN_DURATION="1.5"
SILENCE_KEEP="0.40"

# Silence kept at the very beginning and end of the episode.
EDGE_KEEP="0.25"

# Speech margin preserved either side of every cut, guarding against a word
# boundary that clips a consonant.
CUT_PADDING="0.10"

# Splices shorter than this are not worth making.
MIN_CUT="0.15"

# Fade length at both ends of a per-track mute, to avoid a click.
MUTE_FADE="0.030"

# ------------------------------------------------------------ edit detection --

LLM_ENABLE="1"

# Transcripts are sent as indexed words, in overlapping windows. The model
# replies with word-index ranges, never timestamps — indices are validated
# against the transcript, so it cannot invent a position in the audio.
LLM_CHUNK_WORDS="350"
LLM_CHUNK_OVERLAP="40"

# Sanity bounds on a single edit. Anything larger is rejected as a
# misunderstanding rather than trusted.
LLM_MAX_EDIT_WORDS="12"
LLM_MAX_EDIT_SECONDS="4.0"

LLM_MIN_CONFIDENCE="0.6"
LLM_TEMP="0"

# Available kinds: stutter, repetition, false_start, filler.
# "filler" is off by default — removing every one reads as over-editing. It
# covers the non-lexical hesitation sounds ("um", "uh", "er") and nothing else:
# crutches built from real words ("well…", "you know", "tipo", "né") are
# detected by no kind here. DESIGN.md §6 explains what taking them on would
# cost.
LLM_ACCEPT_KINDS="stutter,repetition,false_start"

# --------------------------------------------------------------- rendering ---

# The output format, independent of whatever came in. FLAC by default: these
# tracks are going on to be mixed, so losing nothing matters more than size.
OUTPUT_CODEC="flac"
OUTPUT_EXT="flac"
OUTPUT_COMPRESSION="8"          # FLAC only
OUTPUT_EXTRA_ARGS=""            # e.g. "-b:a 192k" for a lossy codec

# 24-bit WAV instead:
#OUTPUT_CODEC="pcm_s24le"
#OUTPUT_EXT="wav"
# The encoder is checked for at startup, so a codec this ffmpeg lacks fails
# immediately rather than after transcribing two hours of audio.

# Appended to each participant name in the output filename.
OUTPUT_SUFFIX=""

# Cuts land on frame boundaries, so every track of an episode has to be
# frame-aligned at the same rate — otherwise one cut list removes slightly
# different spans from each track and they drift apart over hundreds of cuts.
#
#   ""       a rate mismatch is an error (resample beforehand yourself)
#   "auto"   resample everything to the highest rate present
#   48000    resample everything to this rate
#
# Off by default because resampling is a real transformation of the audio, not
# just repackaging. When on, the resample happens before frames are fixed, which
# is what keeps the tracks aligned.
RESAMPLE_TO=""

FFMPEG_JOBS="2"

# Rendered duration must land within this fraction of the planned duration or
# the run fails and the inputs are preserved.
DURATION_TOLERANCE="0.02"

# ---------------------------------------------------------------- behaviour ---

# Both default to 0: the work directory is removed and the original inputs are
# deleted, but only after every output track has been verified. Any failure
# preserves both and moves the inputs to FAILED_DIR.
KEEP_WORK="0"
KEEP_INPUTS="0"
