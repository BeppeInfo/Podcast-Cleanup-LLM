# Podcast-Cleanup-LLM configuration.
#
# Copy to one of the locations searched at startup (first match wins):
#
#   the path given to --config
#   $PODCAST_CLEANUP_CONF
#   ./podcast-cleanup.conf
#   ${XDG_CONFIG_HOME:-~/.config}/podcast-cleanup/config
#   /etc/podcast-cleanup.conf
#
# Sourced as bash: only assignments, no logic worth speaking of. Anything left
# unset falls back to the default shown in the comment.

# ---------------------------------------------------------------- filesystem --

# Everything the run reads and writes lives under one root, created on first use.
# The default is the directory holding clean-podcast.sh, which makes a checkout
# self-contained — good for a workstation, where the models are usually remote
# anyway. --root overrides it for a single run.
#PODCAST_ROOT="/srv/media/podcast"

# Derived from the root unless set here:
#
#   INPUT_DIR    $PODCAST_ROOT/incoming    tracks waiting to be processed
#   OUTPUT_DIR   $PODCAST_ROOT/output      finished episodes, one directory each
#   WORK_ROOT    $PODCAST_ROOT/work        per-episode intermediates
#   FAILED_DIR   $PODCAST_ROOT/failed      logs (and inputs, see FAILED_ACTION)
#
# Set them individually only when they genuinely belong apart — output on a
# different volume from the scratch space, say. A setting here beats the root;
# a --root on the command line beats a setting here, since the whole point of
# asking for a root is to move the layout.
#INPUT_DIR="/srv/media/podcast/incoming"
#OUTPUT_DIR="/srv/media/podcast/output"
#WORK_ROOT="/var/tmp/podcast-work"
#FAILED_DIR="/srv/media/podcast/failed"

# Input tracks are named <episode><SEP><participant>.<ext>, e.g.
# "ep042_leonardo.flac" -> episode "ep042", participant "leonardo".
TRACK_SEPARATOR="_"

# Which extensions to look for, matched case-insensitively. Anything ffmpeg can
# decode works — the prepare stage decodes to PCM regardless, so the container is
# only a matter of finding the files. Video containers are fine too; the first
# audio stream is taken.
#
# Two tracks of one episode may be in different formats: decoders handle encoder
# delay correctly, so they stay sample-aligned. What they may *not* do is differ
# in sample rate — see RESAMPLE_TO below.
INPUT_EXTS="flac wav wave aiff aif m4a mp4 mka mkv mp3 ogg oga opus wv ape alac"

# Narrow it if the input directory holds other things you do not want swept up:
#INPUT_EXTS="flac"

# (TRACK_EXT is the old name for this and still works, but it only filters
# inputs now — the output format is set below.)

# ------------------------------------------------------------------- whisper --

# Leave WHISPER_ENDPOINT empty to run whisper-cli locally, once per track. Set
# it to a running whisper-server and transcription is sent there instead, with
# no local process managed.
#
# This is independent of how the LLM stage is served, so all four combinations
# work: both local, both remote, local Whisper with a remote LLM, or a remote
# Whisper with a local LLM. --whisper-endpoint / --local-whisper override this
# per run, as --llama-endpoint / --local-llama do for the LLM.
#
# One caveat: word timings are only as good as what the server returns. A build
# that honours max_len=1 returns one word per segment and the timings are exact;
# one that ignores it returns sentence segments, and word positions inside them
# are interpolated, which makes stutter cuts less tight. The run warns when that
# happens. Local whisper-cli always gives per-token timings.
WHISPER_ENDPOINT=""
#WHISPER_ENDPOINT="http://gpu-box.lan:8080"
WHISPER_ENDPOINT_PATH="/inference"

# Sent as "Authorization: Bearer <key>". whisper.cpp's own server has no
# authentication, so this is for whatever you have put in front of it — a
# reverse proxy, or a hosted endpoint that speaks the same API.
#
# Prefer the _FILE form. A key written here is also a key in your editor's
# backups, and readable by anyone who can read this file; a key in its own file
# can be chmod 600, and one that is readable more widely draws a warning. Either
# way the key never reaches the run log or a command line.
WHISPER_API_KEY=""
#WHISPER_API_KEY_FILE="/etc/podcast-cleanup/whisper.key"

# Audio is uploaded in chunks of this many seconds; 0 sends the whole track in
# one request. Boundaries are nudged onto the middle of a silence found by the
# VAD stage, so a chunk edge does not land inside a word. Chunking also means
# progress is reported as the run goes rather than only at the end.
WHISPER_CHUNK_SECONDS="600"
WHISPER_REQUEST_TIMEOUT="1800"

# Used only when WHISPER_ENDPOINT is empty.
WHISPER_BIN="/opt/whisper.cpp/bin/whisper-cli"
WHISPER_MODEL="/srv/llm/models/whisper/ggml-large-v3-turbo.bin"
WHISPER_THREADS="$(nproc)"

# Language code, or "auto" to detect. Setting it explicitly is both faster and
# more accurate than detection on a two-hour recording.
WHISPER_LANG="auto"
#WHISPER_LANG="pt"

# Passed through verbatim, e.g. --prompt for domain vocabulary.
WHISPER_EXTRA_ARGS=""

# Local Whisper never runs at the same time as a locally managed llama-server:
# every track is transcribed and the process exits before the LLM stage begins.
# Raise this only if there is RAM for several Whisper instances at once.
WHISPER_JOBS="1"

# ----------------------------------------------------------------- llama.cpp --

# Leave LLAMA_ENDPOINT empty to have the script start llama-server itself for
# the detection stage and shut it down immediately afterwards. Set it to an
# existing server to use that instead — the script then never manages a process,
# and keeping that server from competing with anything else for memory is the
# other machine's business.
LLAMA_ENDPOINT=""
#LLAMA_ENDPOINT="http://127.0.0.1:8081"

# Matches llama-server's own --api-key, and applies to a local server too if
# LLAMA_EXTRA_ARGS starts one with that flag. Same advice as for the Whisper key
# above: prefer the _FILE form.
LLAMA_API_KEY=""
#LLAMA_API_KEY_FILE="/etc/podcast-cleanup/llama.key"

LLAMA_SERVER_BIN="/opt/llama.cpp/bin/llama-server"
LLAMA_MODEL="/srv/llm/models/qwen/Qwen3.6-35B-A3B.gguf"
LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8081"

# Context for a server this script starts. Ignored entirely when LLAMA_ENDPOINT
# is set — a remote server's own -c governs, and nothing here checks the two
# agree. At the default LLM_CHUNK_WORDS=350 a request is ~3.3k prompt tokens plus
# 2048 reserved for the reply, so a slot needs about 6k. Note that llama-server
# divides -c among --parallel slots: -c 8192 --parallel 4 leaves 2048 each and
# truncates. See "Running the servers" in the README.
LLAMA_CTX="8192"

# Layers offloaded to GPU (99 = all, 0 = CPU only).
LLAMA_NGL="99"

LLAMA_EXTRA_ARGS=""
LLAMA_STARTUP_TIMEOUT="600"
LLAMA_REQUEST_TIMEOUT="600"

# Which llama.cpp endpoint the detection stage uses.
#
#   chat        /v1/chat/completions. The server applies the chat template of
#               whichever model it has loaded, so the model can be swapped or
#               upgraded without anything here knowing which one it is. This is
#               the reason to prefer it.
#   completion  /completion. A raw prompt with no template applied — the way
#               this used to work. Keep it for a build without the chat
#               endpoint, or to compare the two on the same episode.
LLM_API="chat"

# The model id to name in each request. A llama-server hosting one model ignores
# it, so it can stay empty; one in *router mode* hosts several and refuses any
# request that does not name one — "model name is missing from the request".
# List what a server offers with:
#
#   curl -s http://your-server:8080/v1/models | python3 -m json.tool
#
# A router also has to have the model loaded. If it was started with
# --no-models-autoload, naming an unloaded model gives "model is not loaded"
# and it must be loaded before the run.
LLAMA_MODEL_NAME=""
#LLAMA_MODEL_NAME="Qwen3.6-35B-A3B-Q4_K_M"

# Ceiling on a single reply. A 350-word chunk rarely yields more than a handful
# of edits, so this is generous; raise it only if replies are being cut off
# mid-JSON (the audit log shows the raw text of anything that failed to parse).
LLM_MAX_REPLY_TOKENS="2048"

# Before the first track, send one tiny request and check the reply really is
# schema-constrained JSON. A server that answers /health but ignores
# response_format would otherwise be discovered only after every chunk of every
# track had been dropped as unparseable — an episode reporting no edits at all,
# which is indistinguishable from clean speech. Costs one request.
LLM_CHECK_SCHEMA="1"

# ------------------------------------------------------- silence definition --

# "ffmpeg"  — silencedetect, level based. No extra dependencies.
# "silero"  — Silero VAD, speech based. Needs python torch + silero-vad, and is
#             markedly better at not mistaking breathing or room tone for
#             speech (or speech for silence).
VAD_BACKEND="ffmpeg"

# Anything quieter than this counts as silence, for the ffmpeg backend.
#
# It belongs below the quietest speech and above the noise floor. On a real
# recording here, speech ran from -21dB down to -39dB over a floor near -50dB:
# -35dB sat inside that speech range and cut the quiet end of it, -45dB clears it.
#
# It errs low on purpose, because the two mistakes do not cost the same. Too high
# and quiet speech is cut, which is damage you only find by listening; too low and
# some room tone survives, which is merely a less tight edit.
#
# Raise it toward -35dB for a loud, close-mic'd recording where more silence
# should go; drop it toward -55dB for a quiet one. The run now warns when a
# silence cut swallows words the transcript has, which is the signal that this
# is set too high.
SILENCE_THRESHOLD="-45dB"
SILERO_THRESHOLD="0.5"

# A stretch of time counts as silence only when *no* track has speech in it.
# Gaps longer than SILENCE_MIN_DURATION are shortened to SILENCE_KEEP rather
# than removed outright, so the edit keeps its breathing room.
SILENCE_MIN_DURATION="1.5"
SILENCE_KEEP="0.40"

# Silence kept at the very beginning and end of the episode.
EDGE_KEEP="0.25"

# Speech margin preserved either side of every cut, guarding against a VAD
# boundary that clips a consonant.
CUT_PADDING="0.10"

# Splices shorter than this are not worth making.
MIN_CUT="0.15"

# Fade length at both ends of a per-track mute, to avoid a click.
MUTE_FADE="0.030"

# ------------------------------------------------------------ edit detection --

LLM_ENABLE="1"

# Transcripts are sent as indexed words, in overlapping windows. The model
# replies with word-index ranges, never timestamps — indices are validated
# against the transcript, so it cannot invent a position in the audio.
LLM_CHUNK_WORDS="350"
LLM_CHUNK_OVERLAP="40"

# Sanity bounds on a single edit. Anything larger is rejected as a
# misunderstanding rather than trusted.
LLM_MAX_EDIT_WORDS="12"
LLM_MAX_EDIT_SECONDS="4.0"

LLM_MIN_CONFIDENCE="0.6"
LLM_TEMP="0"

# Available kinds: stutter, repetition, false_start, filler.
# "filler" (um, uh, like, né) is off by default — removing every one of them
# reads as over-editing.
LLM_ACCEPT_KINDS="stutter,repetition,false_start"

# --------------------------------------------------------------- rendering ---

# The output format, independent of whatever came in. FLAC by default: these
# tracks are going on to be mixed, so losing nothing matters more than size.
OUTPUT_CODEC="flac"
OUTPUT_EXT="flac"
OUTPUT_COMPRESSION="8"          # FLAC only
OUTPUT_EXTRA_ARGS=""            # e.g. "-b:a 192k" for a lossy codec

# 24-bit WAV instead:
#OUTPUT_CODEC="pcm_s24le"
#OUTPUT_EXT="wav"
# The encoder is checked for at startup, so a codec this ffmpeg lacks fails
# immediately rather than after transcribing two hours of audio.

# Appended to each participant name in the output filename.
OUTPUT_SUFFIX=""

# Cuts land on frame boundaries, so every track of an episode has to be
# frame-aligned at the same rate — otherwise one cut list removes slightly
# different spans from each track and they drift apart over hundreds of cuts.
#
#   ""       a rate mismatch is an error (resample beforehand yourself)
#   "auto"   resample everything to the highest rate present
#   48000    resample everything to this rate
#
# Off by default because resampling is a real transformation of the audio, not
# just repackaging. When on, the resample happens before frames are fixed, which
# is what keeps the tracks aligned.
RESAMPLE_TO=""

FFMPEG_JOBS="2"

# Rendered duration must land within this fraction of the planned duration or
# the run fails and the inputs are preserved.
DURATION_TOLERANCE="0.02"

# ---------------------------------------------------------------- behaviour ---

# Both default to 0: the work directory is removed and the original inputs are
# deleted, but only after every output track has been verified. Any failure
# preserves both and moves the inputs to FAILED_DIR.
KEEP_WORK="0"
KEEP_INPUTS="0"
